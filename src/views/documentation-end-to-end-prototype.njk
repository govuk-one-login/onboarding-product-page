{% extends "base-side-nav.njk" %}
{% from "macros/breadcrumbs.njk" import breadcrumbs %}
{% from "dist/govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = "GOV.UK One Login prototype" %}
{% set headerNavigationActiveItem = "documentation" %}
{% set sideNav = {name: "documentation", active: "prototype"} %}
{% set breadcrumbs = breadcrumbs(currentPageName = "Documentation") %}

{% block mainContent %}
  <h1 class="govuk-heading-l">GOV.UK One Login prototype</h1>
  <p class="govuk-body">We've created an HTML prototype for government service teams to use to explore journeys within GOV.UK One Login.</p>
  <p class="govuk-body">You can access the prototype by <a class="govuk-link" href="https://admin.sign-in.service.gov.uk/">signing in or creating an admin account.</a></p>
  <div class="govuk-inset-text">We'll update the prototype regularly to reflect live journeys, but it's not an exact copy. It's also not production code.</div>

{% endblock %}
