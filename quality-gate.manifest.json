{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.16.0/schemas/schema.json",
  "services": [
    {
      "product": "Orchestration",
      "component": "GOV.UK One Login product-page",
      "promotionType": "other",
      "promotionTypeDetails": [
        "Only dev and production environments"
      ],
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/validation.yml",
            "path": "$.jobs.run-checkov"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/validation.yml",
            "path": "$.jobs.check-linting"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/validation.yml",
            "path": "$.jobs.check-vulnerabilities"
          },
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/validation.yml",
            "path": "$.jobs.sonarcloud"
          },
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "unit test coverage"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/validation.yml",
            "path": "$.jobs.run-unit-tests"
          },
          "checks": [
            {
              "name": "unit"
            }
          ]
        }
      ]
    }
  ]
}
