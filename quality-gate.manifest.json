{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.14.0/schemas/schema.json",
  "services": [
    {
      "product": "Orchestration",
      "component": "GOV.UK One Login product-page",
      "promotionType": "other",
      "promotionTypeDetails": [
        "Only dev and production environments"
      ],
      "automated": [
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/validation.yml",
            "path": "$.jobs.run-checkov"
          }
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/validation.yml",
            "path": "$.jobs.check-linting"
          }
        },
        {
          "checkTypes": [
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/validation.yml",
            "path": "$.jobs.check-vulnerabilities"
          }
        },
        {
          "checkTypes": [
            "code quality",
            "unit test coverage"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/validation.yml",
            "path": "$.jobs.sonarcloud"
          }
        },
        {
          "checkTypes": [
            "unit"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/validation.yml",
            "path": "$.jobs.run-unit-tests"
          }
        }
      ]
    }
  ]
}
